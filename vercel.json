{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/admin", "destination": "/admin/index.html" }],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
